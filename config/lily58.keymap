#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "tap-preferred";
    tapping_term_ms = <200>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // |  ESC  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            label = "Base";
            bindings = <
&kp ESC                       &kp N1      &kp N2      &kp N3       &kp N4       &kp N5                                  &kp N6    &kp N7       &kp N8        &kp N9      &kp N0          &kp BACKSLASH
&kp TAB                       &kp Q       &kp W       &kp F        &kp P        &td CARET B                             &kp J     &kp L        &kp U         &kp Y       &kp SEMICOLON   &kp GRAVE
&hm LS(LA(LC(LEFT_GUI))) ESC  &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &td MINUS G                             &kp M     &hm LSHFT N  &hm RCTRL E   &hm RALT I  &hm LGUI O      &kp SQT
&kp LSHFT                     &kp Z       &kp X       &kp C        &td PLUS D   &td LS(MINUS) V  &kp LBKT     &kp RBKT  &kp K     &kp H        &td LT COMMA  &td GT DOT  &td EQUAL FSLH  &mo 5
                                                      &kp LPAR     &kp LEFT     &lt 4 SPACE      &lt 3 TAB    &kp RET   &kp BSPC  &lt 2 GRAVE  &kp RPAR
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming {
            bindings = <
&kp ESC                       &kp N1  &kp N2  &kp N3     &kp N4        &kp N5                            &kp N6           &kp N7    &kp N8        &kp N9   &kp N0    &kp NON_US_BACKSLASH
&kp GRAVE                     &kp Q   &kp W   &kp E      &kp R         &kp T                             &kp Y            &kp U     &kp I         &kp O    &kp P     &kp MINUS
&hm LS(LA(LC(LEFT_GUI))) ESC  &kp A   &kp S   &kp D      &kp F         &kp G                             &kp H            &kp J     &kp K         &kp L    &kp SEMI  &kp APOS
&kp LSHFT                     &kp Z   &kp X   &kp C      &kp V         &kp B      &kp LBKT     &kp RBKT  &kp N            &kp M     &kp COMMA     &kp DOT  &kp FSLH  &mo 5
                                              &kp LCTRL  &kp LEFT_ALT  &kp SPACE  &lt 3 TAB    &kp RET   &lt 2 BACKSPACE  &kp LALT  &kp LEFT_GUI
            >;

            label = "qwerty";
        };

        symbols_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            label = "Symbols";
            bindings = <
&trans     &trans    &trans    &trans        &trans      &trans                            &trans     &trans            &trans             &trans    &trans    &trans
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH      &kp DOLLAR  &kp PRCNT                         &kp CARET  &kp AMPS          &kp KP_MULTIPLY    &kp LPAR  &kp RPAR  &kp TILDE
&trans     &kp LGUI  &kp LALT  &hm LCTRL F3  &kp LSHIFT  &kp MINUS                         &kp LBRC   &kp LPAR          &kp RPAR           &kp RBRC  &kp BSLH  &trans
&trans     &trans    &trans    &trans        &kp PLUS    &kp UNDERSCORE  &trans    &trans  &trans     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LBRC  &kp RBRC  &kp PIPE
                               &trans        &trans      &trans          &trans    &trans  &trans     &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            label = "Numpad";
            bindings = <
&trans  &trans        &trans    &trans    &trans    &trans                       &trans     &trans   &trans  &trans  &trans     &trans
&trans  &kp C_VOL_UP  &kp C_PP  &kp LPAR  &kp RPAR  &kp CARET                    &kp MINUS  &kp N7   &kp N8  &kp N9  &kp FSLH   &trans
&trans  &kp C_VOL_DN  &kp Y     &kp LBRC  &kp RBRC  &kp MINUS                    &kp PLUS   &kp N4   &kp N5  &kp N6  &kp STAR   &trans
&trans  &kp Z         &kp X     &kp LBKT  &kp RBKT  &kp UNDER  &trans    &trans  &kp AMPS   &kp N1   &kp N2  &kp N3  &kp EQUAL  &kp COMMA
                                &none     &none     &none      &trans    &kp N0  &kp BSPC   &kp DOT  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navigation_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            label = "Navigation";
            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                  &trans    &trans    &trans  &trans     &trans  &trans
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                                        &trans    &trans    &trans  &trans     &trans  &trans
&kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12                                       &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&out OUT_TOG  &trans        &trans        &trans        &trans        &trans        &kp LG(LS(TAB))    &kp LG(TAB)  &trans    &trans    &trans  &trans     &trans  &trans
                                          &trans        &trans        &trans        &trans             &trans       &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        switchboard {
            bindings = <
&trans  &to 0   &to 1   &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
